<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF pulls in UIAutomationClient (System.Windows.Automation), used only for
         password-field and terminal detection. No WPF UI is used. -->
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Phrasor</AssemblyName>
    <RootNamespace>Phrasor.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationIcon>Assets\Phrasor.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Phrasor</Product>
    <Authors>Maneet Arvind Mehta</Authors>
    <Copyright>Copyright (c) 2026 Maneet Arvind Mehta. MIT License.</Copyright>
    <RepositoryUrl>https://github.com/Maneet7805/Phrasor</RepositoryUrl>
    <Description>Rewrites rough prompts into clear ones on a hotkey.</Description>

    <!-- Single self-contained exe: no .NET runtime needed on the target PC. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Windows (WPF) and System.Windows.Forms both define common type names;
         keep WPF out of the implicit global usings. -->
    <Using Remove="System.Windows" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Phrasor.Core\Phrasor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <!-- Pinned. The shared Evergreen runtime does the browsing; only the loader and managed wrappers are in the exe. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Phrasor.ico" />
    <!-- The main window's pages, served from inside the exe (see EmbeddedWeb). -->
    <!-- Web\contracts holds test examples for Core; they are not shipped. -->
    <EmbeddedResource Include="Web\**\*" Exclude="Web\contracts\**" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
